# Beobachtungsprojekt: Grafana nur intern, Anmeldung mit externem Anbieter (A-029). Werte je Umgebung.
CH_ENVIRONMENT=lokal
CH_GRAFANA_ROOT_URL=http://grafana.internal:3000
CH_GRAFANA_OAUTH_ENABLED=false
CH_GRAFANA_OAUTH_NAME=Anmeldung
CH_GRAFANA_OAUTH_CLIENT_ID=
CH_GRAFANA_OAUTH_AUTH_URL=
CH_GRAFANA_OAUTH_TOKEN_URL=
CH_GRAFANA_OAUTH_API_URL=
CH_GRAFANA_SMTP_ENABLED=false
CH_GRAFANA_SMTP_HOST=
CH_GRAFANA_SMTP_FROM=
CH_BEREITSCHAFT_EMAIL=bereitschaft@example.invalid
