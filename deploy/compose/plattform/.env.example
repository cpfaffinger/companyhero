# Umgebungskonfiguration des Compose-Projekts "plattform". Kopie als .env je Umgebung; keine Geheimnisse hier,
# Geheimnisse liegen als Dateien unter secrets/ (deploy/scripts/bootstrap-secrets.sh).

# Öffentliche Origin (A-032). Lokal: localhost mit internem Zertifikat. Produktion: die Plattformdomain des Betreibers.
CH_ORIGIN=localhost
CH_ACME_EMAIL=
CH_HTTP_PORT=80
CH_HTTPS_PORT=443

# Images (CI setzt Digest-Pins, Betrieb 4). Lokal werden sie aus dem Repository gebaut.
CH_IMAGE_APP=ghcr.io/cpfaffinger/companyhero-app:local
CH_IMAGE_MIGRATE=ghcr.io/cpfaffinger/companyhero-migrate:local
CH_IMAGE_WEB=ghcr.io/cpfaffinger/companyhero-web:local
CH_IMAGE_POSTGRES=ghcr.io/cpfaffinger/companyhero-postgres:local
CH_RELEASE_VERSION=local
CH_IMAGE_DIGEST=

# Anwendungsumgebung: Production, Staging oder Development
CH_ASPNET_ENVIRONMENT=Production

# OpenBao: lokal und in CI automatisch initialisieren und entsiegeln; in Produktion immer false (zwei Personen, Betrieb 3.1).
CH_OPENBAO_AUTO_INIT=true

# Backup-Zeitpunkt der täglichen Basissicherung (UTC-Stunde)
CH_BACKUP_HOUR_UTC=02

# Beobachtung: OTLP-Endpunkt des Collectors im Netz companyhero-beobachtung
CH_OTLP_ENDPOINT=http://otel-collector:4317

# Nur lokale Entwicklung unter WSL auf einem NTFS-Mount (Dateirechte nicht abbildbar); auf Hosts und in CI false.
CH_GARAGE_ALLOW_WORLD_READABLE_SECRETS=false

# Benachrichtigungen (A-032, A-059): SMTP-Transport des Betreibers (Passwort als Datei secrets/smtp_password) und
# Kontaktadresse des VAPID-Schlüssels für Push-Dienste. Ohne CH_SMTP_HOST bleibt der E-Mail-Versand protokolliert statt gesendet.
CH_SMTP_HOST=
CH_SMTP_PORT=587
CH_SMTP_USERNAME=
CH_SMTP_FROM=companyhero@localhost
CH_SMTP_FROM_NAME=CompanyHero
CH_VAPID_SUBJECT=mailto:betrieb@localhost
