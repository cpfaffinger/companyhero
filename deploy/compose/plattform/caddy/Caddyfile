# Eine Plattform-Origin für App, Verwaltung, Kiosk und API (A-032). Caddy ist die einzige öffentlich
# erreichbare Komponente (A-029) und läuft ohne Root; die Standardports 80 und 443 bindet der Container
# über net.ipv4.ip_unprivileged_port_start=0 (compose.yaml), damit Redirects und ACME ohne Portumschreibung stimmen.
{
	admin off
	# ACME-Kontakt des Betreibers (Betrieb 6.1); der Platzhalter gilt nur lokal mit internem Zertifikat.
	email {$CH_ACME_EMAIL:betreiber@example.invalid}
	servers {
		trusted_proxies static private_ranges
	}
}

# Gesundheitsprüfung des Containers über HTTP ohne Umleitung; jeder andere Host auf Port 80 erhält 404.
http:// {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		respond 404
	}
}

{$CH_ORIGIN:localhost} {
	encode zstd gzip

	header {
		# TLS 1.3 und HSTS (A-026, Betrieb 6.1)
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# Strikte CSP ohne Fremdhosts; Schriften und Icons werden selbst ausgeliefert (A-026).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	handle /api/* {
		reverse_proxy api:8080 {
			header_up X-Forwarded-Proto {scheme}
		}
	}

	handle {
		root * /srv/web
		# Gehashte Bundles dürfen lange gecacht werden, die App-Shell nicht.
		@hashed path_regexp \.[0-9A-Za-z_-]{8,}\.(js|css|woff2)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header /ngsw.json Cache-Control "no-cache"
		header /ngsw-worker.js Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		# Zugriffslogs ohne Personenbezug (Betrieb 3.2): keine Query, keine Cookies, keine Client-IP.
		output stdout
		format filter {
			request>uri regexp [?].* ""
			request>headers>Cookie delete
			request>headers>Authorization delete
			request>remote_ip delete
			request>remote_port delete
			request>client_ip delete
			request>headers>User-Agent delete
		}
	}
}
