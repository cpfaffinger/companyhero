{
  "name": "companyhero-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "test:ci": "ng test --watch=false",
    "e2e": "playwright test",
    "ladebudget": "node scripts/ladebudget.mjs",
    "api:export": "node scripts/api-export.mjs",
    "api:generate": "openapi-typescript ../backend/CompanyHero.Api/Contracts/openapi.json -o src/libs/api-client/generated/api.ts --alphabetize --empty-objects-unknown"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource-variable/material-symbols-rounded": "5.3.7",
    "qrcode": "1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "jsdom": "^30.0.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.8.1",
    "stylelint": "17.15.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "engines": {
    "node": "24.15.0",
    "npm": ">=11.0.0"
  }
}
